# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:AA_bu_yerga_BotFather_tokeni

# Telegram User ID of the account owner (can be obtained from @userinfobot)
OWNER_ID=123456789

# Bank card number sent on triggers (formatted in <code>...</code> for one-tap copy)
CARD_NUMBER=0000 0000 0000 0000

# Delete owner's trigger message after response is sent (true/false)
DELETE_TRIGGER_MESSAGE=true

# Anti-spam cooldown per chat per trigger in seconds
COOLDOWN_SECONDS=30

# Path to SQLite database file
DB_PATH=bot_data.sqlite3

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Debtor daily reminder schedule (default: 12:00)
NOTIFICATION_HOUR=12
NOTIFICATION_MINUTE=0
TIMEZONE=Asia/Tashkent

# ---- Faqat Vercel uchun ----
# Supabase (faqat Storage ishlatiladi, SQL yozish shart emas)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Kunlik eslatmani faqat Vercel Cron ishga tushira olishi uchun (istalgan tasodifiy satr)
CRON_SECRET=tasodifiy-uzun-satr
